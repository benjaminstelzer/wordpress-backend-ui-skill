{
  "name": "wordpress-backend-ui-skill",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "Development and validation fixture for the WordPress Backend UI Agent Skill.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "wp-scripts build fixture/plugin/src/index.js --output-path=fixture/plugin/build && node scripts/copy-design-tokens.mjs",
    "check:contracts": "python wordpress-backend-ui/scripts/validate_contracts.py . && python tests/test_version_compatibility.py",
    "check:local-wordpress": "python tests/test_local_wordpress_compatibility.py",
    "i18n:pot": "wp i18n make-pot fixture/plugin fixture/plugin/languages/wordpress-backend-skill-fixture.pot --domain=wordpress-backend-skill-fixture --exclude=src,languages",
    "i18n:mo": "wp i18n make-mo fixture/plugin/languages/wordpress-backend-skill-fixture-de_DE.po fixture/plugin/languages/wordpress-backend-skill-fixture-de_DE.mo",
    "i18n:json": "wp i18n make-json fixture/plugin/languages/wordpress-backend-skill-fixture-de_DE.po fixture/plugin/languages --no-purge",
    "i18n": "npm run i18n:pot && npm run i18n:mo && npm run i18n:json",
    "test:xampp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-xampp-fixtures.ps1"
  },
  "devDependencies": {
    "@wordpress/admin-ui": "1.8.1",
    "@wordpress/components": "32.2.1",
    "@wordpress/date": "5.40.1",
    "@wordpress/element": "6.40.1",
    "@wordpress/i18n": "6.13.1",
    "@wordpress/scripts": "32.0.0",
    "@wordpress/theme": "0.7.1",
    "@wordpress/ui": "0.7.1",
    "@playwright/test": "1.58.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
